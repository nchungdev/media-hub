{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Python Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/server.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Desktop App (Cargo)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin=media-hub"],
        "filter": {
          "name": "media-hub",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}/src-tauri"
    }
  ]
}
