{
  "name": "antigravity-media-hub",
  "version": "2.4.0",
  "description": "Antigravity Media Hub - Desktop AI Media Command Center",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --arm64",
    "check": "node --check src/main/index.js && node --check src/preload/index.js"
  },
  "keywords": [
    "media",
    "subtitles",
    "ai",
    "agent",
    "plex",
    "antigravity"
  ],
  "author": "Antigravity Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.antigravity.mediahub",
    "productName": "Media Hub",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dir",
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../scripts",
        "to": "scripts",
        "filter": ["**/*"]
      },
      {
        "from": "../templates",
        "to": "templates",
        "filter": ["**/*"]
      }
    ]
  }
}
