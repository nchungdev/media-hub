#!/usr/bin/env bash
# ==============================================================================
# Antigravity Media Hub Standalone CLI & Desktop App Launcher
# ==============================================================================

set -e

# Resolve script directory (handle symlinks cleanly)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
APP_DIR="$( cd -P "$BIN_DIR/.." >/dev/null 2>&1 && pwd )"
ELECTRON_DIR="$APP_DIR/electron"
SERVER_SCRIPT="$APP_DIR/scripts/server.py"

DEFAULT_PORT=8888
DEFAULT_HOST="127.0.0.1"

# Setup Node/NPM in PATH if present
export PATH="/Users/chungnh/.local/share/fnm/node-versions/v24.20.0/installation/bin:$HOME/.local/bin:$PATH"

# Find or create .media-hub state directory
find_state_dir() {
  local target="${MEDIA_HUB_WORKSPACE:-$PWD}"
  local cur="$target"
  while [ "$cur" != "/" ]; do
    if [ -d "$cur/.media-hub" ]; then
      echo "$cur/.media-hub"
      return 0
    fi
    cur="$(dirname "$cur")"
  done
  echo "$target/.media-hub"
}

STATE_DIR="$(find_state_dir)"
mkdir -p "$STATE_DIR"
PID_FILE="$STATE_DIR/media_hub.pid"
LOG_FILE="$STATE_DIR/server.log"

get_running_pid() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "$pid"
      return 0
    fi
  fi
  local lsof_pid
  lsof_pid=$(lsof -ti:$DEFAULT_PORT 2>/dev/null || true)
  if [ -n "$lsof_pid" ]; then
    echo "$lsof_pid" | head -n1
    return 0
  fi
  echo ""
}

cmd_start() {
  local port="$DEFAULT_PORT"
  local should_open=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port|-p)
        port="$2"
        shift 2
        ;;
      --open|-o)
        should_open=true
        shift
        ;;
      --workspace|-w)
        export MEDIA_HUB_WORKSPACE="$2"
        STATE_DIR="$(find_state_dir)"
        PID_FILE="$STATE_DIR/media_hub.pid"
        LOG_FILE="$STATE_DIR/server.log"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  local pid
  pid=$(get_running_pid)
  if [ -n "$pid" ]; then
    echo "⚡ Media Hub đã đang chạy (PID: $pid) tại http://$DEFAULT_HOST:$DEFAULT_PORT"
    if [ "$should_open" = true ]; then
      cmd_open
    fi
    return 0
  fi

  echo "🚀 Đang khởi chạy Antigravity Media Hub..."
  echo "   📁 Workspace: ${MEDIA_HUB_WORKSPACE:-$PWD}"
  echo "   🌐 Dashboard: http://$DEFAULT_HOST:$port"
  echo "   📜 Server Log: $LOG_FILE"

  export PORT="$port"
  nohup python3 "$SERVER_SCRIPT" > "$LOG_FILE" 2>&1 &
  local new_pid=$!
  echo "$new_pid" > "$PID_FILE"

  sleep 1.5
  if kill -0 "$new_pid" 2>/dev/null; then
    echo "✅ Media Hub đã khởi chạy thành công (PID: $new_pid)!"
    if [ "$should_open" = true ]; then
      cmd_open
    fi
  else
    echo "❌ Khởi chạy thất bại. Kiểm tra log tại $LOG_FILE:"
    tail -n 20 "$LOG_FILE"
    exit 1
  fi
}

cmd_desktop() {
  echo "🖥️ Đang khởi chạy Antigravity Media Hub Electron Desktop App..."
  if [ ! -d "$ELECTRON_DIR/node_modules" ]; then
    echo "📦 Đang cài đặt gói Electron (lần đầu tiên)..."
    (cd "$ELECTRON_DIR" && npm install)
  fi
  (cd "$ELECTRON_DIR" && npm start)
}

cmd_build() {
  echo "📦 Đang đóng gói Media Hub thành macOS Native App (.dmg & .app)..."
  if [ ! -d "$ELECTRON_DIR/node_modules" ]; then
    (cd "$ELECTRON_DIR" && npm install)
  fi
  (cd "$ELECTRON_DIR" && npm run build)
  echo "🎉 Đóng gói hoàn tất! File cài đặt nằm tại: $ELECTRON_DIR/dist"
}

cmd_stop() {
  local pid
  pid=$(get_running_pid)
  if [ -z "$pid" ]; then
    echo "ℹ️ Media Hub hiện không chạy."
    rm -f "$PID_FILE"
    return 0
  fi

  echo "🛑 Đang dừng Media Hub (PID: $pid)..."
  kill "$pid" 2>/dev/null || true
  sleep 1
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  echo "✅ Đã dừng Media Hub."
}

cmd_restart() {
  cmd_stop
  sleep 1
  cmd_start "$@"
}

cmd_status() {
  local pid
  pid=$(get_running_pid)
  echo "=========================================="
  echo "🪐 Antigravity Media Hub Standalone Status"
  echo "=========================================="
  if [ -n "$pid" ]; then
    echo "  Trạng thái: 🟢 ĐANG HOẠT ĐỘNG (RUNNING)"
    echo "  Process ID: $pid"
    echo "  URL Web UI: http://$DEFAULT_HOST:$DEFAULT_PORT"
    echo "  State Dir : $STATE_DIR"
    echo "  Log File  : $LOG_FILE"
  else
    echo "  Trạng thái: 🔴 ĐÃ DỪNG (STOPPED)"
    echo "  State Dir : $STATE_DIR"
  fi
  echo "=========================================="
}

cmd_logs() {
  if [ ! -f "$LOG_FILE" ]; then
    echo "ℹ️ Chưa có file log tại $LOG_FILE"
    return 0
  fi
  if [ "$1" == "-f" ] || [ "$1" == "--follow" ]; then
    tail -f "$LOG_FILE"
  else
    tail -n 50 "$LOG_FILE"
  fi
}

cmd_open() {
  local url="http://$DEFAULT_HOST:$DEFAULT_PORT"
  echo "🌐 Đang mở Media Hub trên trình duyệt: $url"
  if which open >/dev/null 2>&1; then
    open "$url"
  elif which xdg-open >/dev/null 2>&1; then
    xdg-open "$url"
  else
    echo "Vui lòng mở link: $url"
  fi
}

cmd_tunnel() {
  local subcmd="${1:-status}"
  shift || true

  python3 -c "
import sys, json, urllib.request, urllib.error
server_url = 'http://$DEFAULT_HOST:$DEFAULT_PORT'
sub = '$subcmd'

def api_call(path, data=None):
    url = f'{server_url}{path}'
    req = urllib.request.Request(url, headers={'Content-Type': 'application/json'})
    if data is not None:
        req.data = json.dumps(data).encode('utf-8')
    try:
        with urllib.request.urlopen(req, timeout=15) as res:
            return json.loads(res.read().decode('utf-8'))
    except Exception:
        return None

# Try server API first
status = api_call('/api/tunnel/status')

if sub == 'start':
    if status:
        res = api_call('/api/tunnel/start', {'port': $DEFAULT_PORT}) or {}
        if res.get('success'):
            print(f'🌐 Cloudflare Tunnel Online: {res.get(\"url\")}')
        else:
            print(f'❌ Lỗi: {res.get(\"error\")}')
    else:
        sys.path.append('$APP_DIR/scripts')
        from core.tunnel import tunnel_mgr
        res = tunnel_mgr.start($DEFAULT_PORT)
        if res.get('success'):
            print(f'🌐 Cloudflare Tunnel Online: {res.get(\"url\")}')
        else:
            print(f'❌ Lỗi: {res.get(\"error\")}')

elif sub == 'stop':
    if status:
        res = api_call('/api/tunnel/stop', {}) or {}
        print(res.get('message', 'Đã tắt tunnel'))
    else:
        sys.path.append('$APP_DIR/scripts')
        from core.tunnel import tunnel_mgr
        res = tunnel_mgr.stop()
        print(res.get('message', 'Đã tắt tunnel'))

elif sub == 'url':
    st = status
    if not st:
        sys.path.append('$APP_DIR/scripts')
        from core.tunnel import tunnel_mgr
        st = tunnel_mgr.get_status()
    if st and st.get('running') and st.get('url'):
        print(st.get('url'))
    else:
        print('Offline')

elif sub == 'open':
    st = status
    if not st:
        sys.path.append('$APP_DIR/scripts')
        from core.tunnel import tunnel_mgr
        st = tunnel_mgr.get_status()
    url = st.get('url') if st else None
    if url:
        import subprocess
        subprocess.run(['open', url])
    else:
        print('Tunnel chưa chạy. Chạy: media-hub tunnel start')

else:
    st = status
    if not st:
        sys.path.append('$APP_DIR/scripts')
        from core.tunnel import tunnel_mgr
        st = tunnel_mgr.get_status()
    print('========================================')
    print(' Cloudflare Quick Tunnel (TryCloudflare)')
    print('========================================')
    print(f' Binary:     {st.get(\"binary\")}')
    print(f' Installed:  {\"✅ Có\" if st.get(\"installed\") else \"❌ Chưa\"}')
    print(f' Running:    {\"🟢 Đang trực tuyến\" if st.get(\"running\") else \"⚪ Đang tắt\"}')
    if st.get('running'):
        print(f' Public URL: {st.get(\"url\")}')
        print(f' Started:    {st.get(\"started_at\")}')
    if st.get('error'):
        print(f' Error:      {st.get(\"error\")}')
    print('========================================')
"
}

cmd_cli() {
  local subcmd="${1:-status}"
  shift || true

  python3 -c "
import sys, json, time, urllib.request, urllib.error
server_url = 'http://$DEFAULT_HOST:$DEFAULT_PORT'
sub = '$subcmd'

def api_call(path, data=None):
    url = f'{server_url}{path}'
    req = urllib.request.Request(url, headers={'Content-Type': 'application/json'})
    if data is not None:
        req.data = json.dumps(data).encode('utf-8')
    try:
        with urllib.request.urlopen(req, timeout=10) as res:
            return json.loads(res.read().decode('utf-8'))
    except Exception:
        return None

if sub in ['status', 'ensure']:
    res = api_call('/api/agent/service/status')
    if not res:
        import os
        from pathlib import Path
        sf = Path.home() / '.media-hub' / 'cli_service.json'
        if sf.exists():
            with open(sf, 'r') as f:
                res = json.load(f)
        else:
            res = {'status': 'idle', 'message': 'Server offline'}
    
    print('========================================')
    print(' Antigravity CLI Agent Service')
    print('========================================')
    st = res.get('status', 'idle')
    is_running = res.get('is_running') or st in ['running', 'attached']
    print(f' Trạng thái:  {\"🟢 RUNNING / ATTACHED\" if is_running else \"⚪ IDLE / READY\"}')
    aj = res.get('active_job') or {}
    if aj:
        print(f' CLI Bin:     {aj.get(\"cli\", \"agy\")}')
        print(f' Process PID: {aj.get(\"pid\", \"--\")}')
        print(f' Media ID:    {aj.get(\"media_id\", \"--\")}')
        print(f' Session ID:  {aj.get(\"conversation_id\", \"--\")}')
        print(f' Bắt đầu lúc: {aj.get(\"start_time\", \"--\")}')
        print(f' Lệnh:        {aj.get(\"command\", \"--\")}')
    print('========================================')

elif sub == 'sessions':
    res = api_call('/api/agent/sessions')
    if res is None:
        print('Không kết nối được server để lấy danh sách session.')
    else:
        print('========================================')
        print(' Registered Media / Skill Sessions')
        print('========================================')
        if not res:
            print('  (Chưa có session nào. Sẽ tự động tạo khi chạy tác vụ)')
        for k, v in res.items():
            print(f' 🎯 {k.ljust(25)} ➔ {v}')
        print('========================================')

elif sub == 'stop':
    res = api_call('/api/agent/stop', {})
    if res:
        print(res.get('message', 'Đã gửi lệnh dừng CLI'))
    else:
        print('Không kết nối được server.')

elif sub == 'attach':
    print('🔗 Đang gắn kết (Attach) vào dòng nhật ký Live CLI...')
    seen = 0
    try:
        while True:
            data = api_call('/api/agent/live_logs')
            if data:
                logs = data.get('logs', [])
                for entry in logs[seen:]:
                    t = entry.get('time', '')
                    txt = entry.get('text', '')
                    lvl = entry.get('level', 'info')
                    color = '\033[33m' if lvl == 'thinking' else '\033[32m' if lvl == 'subagent' else '\033[36m' if lvl == 'tool' else '\033[0m'
                    print(f'{color}[{t}] {txt}\033[0m')
                seen = len(logs)
            time.sleep(1)
    except KeyboardInterrupt:
        print('\n👋 Đã tách (Detach) khỏi luồng console. Tiến trình CLI vẫn tiếp tục chạy ngầm!')

else:
    print(f'Lệnh CLI không hợp lệ: {sub}. Các lệnh hỗ trợ: status, ensure, attach, stop, sessions')
"
}

cmd_help() {
  echo "Antigravity Media Hub Standalone CLI & Desktop"
  echo ""
  echo "Cú pháp: media-hub <command> [options]"
  echo ""
  echo "Lệnh hỗ trợ:"
  echo "  app / desktop                  Mở ứng dụng Electron Desktop độc lập"
  echo "  start [--open] [--port 8888]   Khởi chạy server Media Hub ngầm"
  echo "  stop                           Dừng server Media Hub"
  echo "  restart                        Khởi động lại server"
  echo "  status                         Kiểm tra trạng thái máy chủ"
  echo "  logs [-f]                      Xem log của máy chủ"
  echo "  open                           Mở Web Dashboard trên trình duyệt"
  echo "  cli [status|attach|stop|sessions] Quản lý dịch vụ CLI độc lập và gắn kết"
  echo "  tunnel [start|stop|status|open] Quản lý Cloudflare Tunnel truy cập từ xa"
  echo "  build                          Đóng gói thành file cài đặt macOS (.dmg / .app)"
  echo "  help                           Hiển thị trợ giúp này"
  echo ""
}

case "$1" in
  app|desktop)
    cmd_desktop
    ;;
  build|dist)
    cmd_build
    ;;
  start)
    shift
    cmd_start "$@"
    ;;
  stop)
    cmd_stop
    ;;
  restart)
    shift
    cmd_restart "$@"
    ;;
  status)
    cmd_status
    ;;
  logs)
    shift
    cmd_logs "$@"
    ;;
  open)
    cmd_open
    ;;
  cli)
    shift
    cmd_cli "$@"
    ;;
  tunnel)
    shift
    cmd_tunnel "$@"
    ;;
  help|--help|-h|"")
    cmd_help
    ;;
  *)
    echo "Lệnh không hợp lệ: $1"
    cmd_help
    exit 1
    ;;
esac
