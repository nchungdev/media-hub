{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Hub",
  "version": "2.5.0",
  "identifier": "com.antigravity.mediahub",
  "build": {
    "frontendDist": "../templates",
    "devUrl": "http://127.0.0.1:8888"
  },
  "app": {
    "windows": [
      {
        "title": "Media Hub",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Video",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
